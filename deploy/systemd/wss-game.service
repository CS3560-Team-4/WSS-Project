[Unit]
Description=Wilderness Survival System backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=true
WorkingDirectory=/opt/wss-game
ExecStart=/usr/bin/java -jar /opt/wss-game/game-server.jar
Environment=HOST=127.0.0.1
Environment=PORT=8080
Environment=CORS_ALLOWED_ORIGINS=https://cs3560-team-4.github.io
Restart=always
RestartSec=3

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
